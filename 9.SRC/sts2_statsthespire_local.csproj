<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sts2_statsthespire_local</AssemblyName>
    <RootNamespace>CommunityStats</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.9.6</Version>
    <AssemblyVersion>1.9.6.0</AssemblyVersion>
    <FileVersion>1.9.6.0</FileVersion>

    <!-- Reproducible release binaries must not embed the builder's profile path. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <!-- Game install directory. Override with -p:STS2GameDir=... for another version. -->
    <STS2GameDir Condition="'$(STS2GameDir)' == ''">C:\Game\Steam\steamapps\common\Slay the Spire 2</STS2GameDir>

    <!-- Output to bin/<Configuration>; package step copies the DLL next to manifest. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Copy only our DLL, not dependencies (game already has them) -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Suppress .deps.json generation (STS2 scans all .json as mod manifests) -->
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!--
      One DLL supports v0.111.1 and v0.113.1. Version-specific game APIs are
      selected at runtime; do not define per-version compilation symbols.
    -->
  </PropertyGroup>

  <!--
    RitsuLib is a hard runtime dependency. The package supplies compile-time
    facades; players install the complete STS2-RitsuLib mod folder. Do not
    copy RitsuLib assemblies into this mod's output.
  -->
  <ItemGroup>
    <PackageReference Include="STS2.RitsuLib" Version="0.6.14" PrivateAssets="all" />
  </ItemGroup>

  <!-- STS2 game assemblies -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDir)\data_sts2_windows_x86_64\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDir)\data_sts2_windows_x86_64\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDir)\data_sts2_windows_x86_64\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
